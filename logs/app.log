Description: Monthly payroll processing records showing gross pay, net pay, and payment dates.
Schema DDL:
CREATE TABLE payroll_runs (id UUID PRIMARY KEY, vendor_id UUID NOT NULL, employee_id UUID REFERENCES employees(id), pay_period_start DATE, pay_period_end DATE, gross_pay NUMERIC(12, 2), net_pay NUMERIC(12, 2), payment_date DATE, status VARCHAR(50));
Relationships:
vendor_id refers to tenant. employee_id refers to employees.id.

Table Name: employees
Description: Master list of all staff members and their salaries
Schema DDL:
CREATE TABLE employees (id UUID PRIMARY KEY, vendor_id UUID NOT NULL, first_name VARCHAR(100), last_name VARCHAR(100), department VARCHAR(100), role VARCHAR(100), base_salary NUMERIC(12, 2), hire_date DATE, is_active BOOLEAN);
Relationships:
vendor_id refers to the tenant company.

Table Name: payroll_deductions
Description: Breakdown of deductions and taxes taken out of an employee's pay for a specific payroll run.
Schema DDL:
CREATE TABLE payroll_deductions (id UUID PRIMARY KEY, vendor_id UUID NOT NULL, payroll_run_id UUID REFERENCES payroll_runs(id), deduction_type VARCHAR(100), amount NUMERIC(10, 2));
Relationships:
vendor_id refers to tenant. payroll_run_id refers to payroll_runs.id.
